{
  "name": "pastaroma",
  "version": "1.0.0",
  "description": "Pastaroma Restaurant Website",
  "scripts": {
    "dev": "npm run build && concurrently \"npm run watch\" \"serve -p 3000\"",
    "start": "serve -p 3000",
    "build": "tailwindcss -i ./src/css/input.css -o ./dist/css/output.css --minify",
    "watch": "tailwindcss -i ./src/css/input.css -o ./dist/css/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19"
  },
  "main": "tailwind.config.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
